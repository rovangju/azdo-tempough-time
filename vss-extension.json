{
  "manifestVersion": 1,
  "id": "tempough-time",
  "version": "0.1.3",
  "name": "Time Entry for Tempough",
  "publisher": "ITNobody",
  "description": "Easily create Tempough time entries from Azure DevOps work items",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services.Cloud"
    }
  ],
  "categories": ["Azure Boards"],
  "tags": ["time tracking", "time entry", "Azure Boards", "work items", "Tempough"],
  "icons": {
    "default": "images/icon.png"
  },
  "branding": {
    "color": "#17324d",
    "theme": "dark"
  },
  "scopes": ["vso.work", "vso.extension.data_write"],
  "content": {
    "details": {
      "path": "OVERVIEW.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "contributions": [
    {
      "id": "tempough-work-item-form-group",
      "type": "ms.vss-work-web.work-item-form-group",
      "description": "Create a Tempough time entry from a work item.",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "Log time to Tempough",
        "uri": "work-item-form.html",
        "height": 470
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true,
      "packagePath": "/"
    },
    {
      "path": "PRIVACY.md",
      "addressable": true
    },
    {
      "path": "docs/preview.png",
      "addressable": true
    }
  ]
}
